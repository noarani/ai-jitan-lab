---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, SITE_TAGLINE, PILLARS } from '../consts';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  publishedAt?: string;
  updatedAt?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  isHome?: boolean;
}
const props = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="ja">
  <head>
    <BaseHead {...props} />
  </head>
  <body>
    <a class="skip" href="#main">本文へ</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={`${base}/`}>
          <strong>{SITE_TITLE}</strong>
          <span>{SITE_TAGLINE}</span>
        </a>
        <nav aria-label="主要カテゴリ">
          <ul>
            {PILLARS.map((p) => (
              <li><a href={`${base}/${p.slug}/`}>{p.short}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>
          <a href={`${base}/about/`}>運営者情報・編集方針</a> ・
          <a href={`${base}/rss.xml`}>RSS</a>
        </p>
        <p class="fine">
          このサイトの記事は一般的な手順の解説です。法令適合、契約上の妥当性、
          情報セキュリティ、成果を保証しません。個別の判断が必要な場合は、
          社内の責任者や専門家にご確認ください。
        </p>
        <p class="fine">© {year} {SITE_TITLE}</p>
      </div>
    </footer>

    <style is:global>
      :root {
        --fg: #1a1a1a;
        --muted: #5b6068;
        --bg: #ffffff;
        --accent: #0b6cd4;
        --line: #e4e7eb;
        --maxw: 720px;
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        color: var(--fg);
        background: var(--bg);
        font-family: -apple-system, BlinkMacSystemFont, "Hiragino Sans",
          "Yu Gothic UI", "Meiryo", system-ui, sans-serif;
        line-height: 1.85;
        font-size: 17px;
      }
      .wrap { max-width: var(--maxw); margin-inline: auto; padding-inline: 20px; }
      a { color: var(--accent); text-underline-offset: 2px; }
      .skip {
        position: absolute; left: -9999px;
      }
      .skip:focus { left: 8px; top: 8px; background: #fff; padding: 8px; z-index: 10; }

      .site-header { border-bottom: 1px solid var(--line); }
      .site-header .wrap { padding-block: 14px; }
      .brand { display: inline-flex; flex-direction: column; text-decoration: none; color: var(--fg); }
      .brand strong { font-size: 19px; }
      .brand span { font-size: 12.5px; color: var(--muted); }
      .site-header nav ul {
        list-style: none; display: flex; flex-wrap: wrap; gap: 6px 16px;
        padding: 0; margin: 10px 0 0;
      }
      .site-header nav a { font-size: 14px; }

      main.wrap { padding-block: 32px 56px; }
      h1 { font-size: 27px; line-height: 1.5; margin: 0 0 8px; }
      h2 { font-size: 21px; line-height: 1.5; margin: 40px 0 10px; padding-top: 6px; }
      h3 { font-size: 18px; margin: 28px 0 8px; }
      p { margin: 0 0 16px; }
      ul, ol { padding-left: 1.4em; }
      li { margin: 6px 0; }
      pre {
        background: #f5f6f8; border: 1px solid var(--line); border-radius: 8px;
        padding: 14px 16px; overflow-x: auto; font-size: 14px; line-height: 1.7;
      }
      code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
      :not(pre) > code { background: #f0f2f5; padding: 1px 5px; border-radius: 4px; font-size: 0.92em; }
      blockquote {
        margin: 16px 0; padding: 8px 16px; border-left: 3px solid var(--accent);
        background: #f7f9fc; color: #33383f;
      }
      table { border-collapse: collapse; width: 100%; display: block; overflow-x: auto; }
      th, td { border: 1px solid var(--line); padding: 8px 10px; text-align: left; font-size: 14.5px; }

      .lead { font-size: 15px; color: var(--muted); }
      .meta { font-size: 13.5px; color: var(--muted); margin: 0 0 24px; }
      .cta {
        margin: 32px 0; padding: 16px 18px; border: 1px solid var(--line);
        border-radius: 10px; background: #fafbfc;
      }
      .cta p { margin: 0 0 8px; font-size: 15px; }
      .cta a { font-weight: 600; }
      .card-list { list-style: none; padding: 0; }
      .card-list li { border-bottom: 1px solid var(--line); padding: 14px 0; margin: 0; }
      .card-list a { font-weight: 600; font-size: 16px; }
      .card-list p { margin: 4px 0 0; font-size: 14px; color: var(--muted); }

      .site-footer { border-top: 1px solid var(--line); margin-top: 40px; }
      .site-footer .wrap { padding-block: 24px 40px; }
      .site-footer p { margin: 6px 0; font-size: 13.5px; }
      .site-footer .fine { color: var(--muted); font-size: 12.5px; line-height: 1.7; }

      @media (prefers-color-scheme: dark) {
        :root {
          --fg: #e6e8eb; --muted: #9aa1aa; --bg: #14161a;
          --accent: #6fb3ff; --line: #2a2e35;
        }
        pre { background: #1c1f24; }
        :not(pre) > code { background: #23272e; }
        blockquote { background: #1b1e24; color: #c9cdd3; }
        .cta { background: #1a1d22; }
      }
    </style>
  </body>
</html>
