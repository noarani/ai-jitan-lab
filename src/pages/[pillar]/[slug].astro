---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { PILLARS } from '../../consts';

export const getStaticPaths = (async () => {
  const guides = await getCollection('guides', ({ data }) => !data.draft);
  return guides.map((g) => ({
    params: { pillar: g.data.pillar, slug: g.id },
    props: { entry: g },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const data = entry.data;
const pillar = PILLARS.find((p) => p.slug === data.pillar)!;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(`${base}/${data.pillar}/${entry.id}/`, Astro.site).href;

const toc = headings.filter((h) => h.depth === 2);

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  datePublished: data.publishedAt,
  dateModified: data.updatedAt ?? data.publishedAt,
  mainEntityOfPage: canonical,
  author: { '@type': 'Organization', name: 'AI時短ラボ' },
  publisher: { '@type': 'Organization', name: 'AI時短ラボ' },
};
const crumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: new URL(base + '/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: pillar.title, item: new URL(`${base}/${pillar.slug}/`, Astro.site).href },
    { '@type': 'ListItem', position: 3, name: data.title },
  ],
};
const faqLd =
  data.faq && data.faq.length
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: data.faq.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;
const jsonLd = [articleLd, crumbLd, ...(faqLd ? [faqLd] : [])];
---
<BaseLayout
  title={data.title}
  description={data.description}
  type="article"
  publishedAt={data.publishedAt}
  updatedAt={data.updatedAt ?? data.publishedAt}
  jsonLd={jsonLd}
>
  <p class="meta">
    <a href={`${base}/`}>ホーム</a> ／
    <a href={`${base}/${pillar.slug}/`}>{pillar.short}</a>
  </p>
  <h1>{data.title}</h1>
  <p class="meta">
    公開：{data.publishedAt}
    {data.updatedAt && data.updatedAt !== data.publishedAt ? `／更新：${data.updatedAt}` : ''}
  </p>

  {toc.length > 2 && (
    <nav class="cta" aria-label="目次">
      <p><strong>目次</strong></p>
      <ul>
        {toc.map((h) => (
          <li><a href={`#${h.slug}`}>{h.text}</a></li>
        ))}
      </ul>
    </nav>
  )}

  <article>
    <Content />
  </article>

  {data.faq && data.faq.length > 0 && (
    <section>
      <h2>よくある質問</h2>
      {data.faq.map((f) => (
        <>
          <h3>{f.q}</h3>
          <p>{f.a}</p>
        </>
      ))}
    </section>
  )}

  <p class="meta" style="margin-top:40px">
    ← <a href={`${base}/${pillar.slug}/`}>{pillar.title}の記事一覧へ戻る</a>
  </p>
</BaseLayout>
