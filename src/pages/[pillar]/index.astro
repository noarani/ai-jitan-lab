---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { PILLARS } from '../../consts';

export const getStaticPaths = (async () => {
  return PILLARS.map((p) => ({ params: { pillar: p.slug }, props: { pillar: p } }));
}) satisfies GetStaticPaths;

const { pillar } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const articles = (
  await getCollection('guides', ({ data }) => !data.draft && data.pillar === pillar.slug)
).sort((a, b) => (a.data.publishedAt < b.data.publishedAt ? 1 : -1));

const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: new URL(base + '/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: pillar.title },
  ],
};
---
<BaseLayout
  title={pillar.title}
  description={`${pillar.title}に関する記事のハブページ。1記事1テーマで、確認手順まで具体的にまとめています。`}
  jsonLd={crumbs}
>
  <p class="meta"><a href={`${base}/`}>ホーム</a> ／ {pillar.short}</p>
  <h1>{pillar.title}</h1>

  {articles.length === 0 ? (
    <p>このカテゴリの記事は準備中です。</p>
  ) : (
    <ul class="card-list">
      {articles.map((g) => (
        <li>
          <a href={`${base}/${pillar.slug}/${g.id}/`}>{g.data.title}</a>
          <p>{g.data.description}</p>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
